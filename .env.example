# Docker Compose reads this file when copied to .env.
# Local Python commands read environment variables directly.
APP_ENV=development
PUBLIC_ORIGIN=http://localhost:5173
DATA_DIR=.local/data
BACKUP_DIR=.local/backups
# Local CLI secret files stay outside data and backup directories; Compose uses its private volume.
PROVIDER_SECRET_DIR=secrets
# Optional local managed storage is separate, pre-provisioned and never enables a provider.
# Compose uses its separate private volume; no key-import API is installed yet.
# MANAGED_PROVIDER_SECRET_DIR=/absolute/preprovisioned/managed-secrets
LOG_LEVEL=INFO
WEB_PORT=8080
# Change this pair together if it overlaps a LAN/VPN/Docker subnet or another instance.
APP_SUBNET=172.30.93.0/24
WEB_INTERNAL_IP=172.30.93.10
TZ=Asia/Hong_Kong
# Install the optional parser in the image only; this does not enable any provider traffic.
ENABLE_YFINANCE=false
# Never configure a default owner password.
